        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>crm:P46_is_composed_of</AbbreviatedIRI>
        <Literal xml:lang="ru">составлeн из</Literal>
    </AnnotationAssertion>
