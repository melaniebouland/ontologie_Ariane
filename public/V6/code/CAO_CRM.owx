    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:creator"/>
        <Literal xml:lang="en">Model created by the Consortium HN Ariane and encoded by Mélanie Bouland</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <Literal xml:lang="en">This ontological model was created by the Consortium HN Ariane. The aim is to formalize and improve the description of metada around corpora. Named CAO CRM, this model uses the CIDOC CRM and his extensions, LRMoo and CRMdig.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:rights"/>
        <Literal xml:lang="en">CC BY-NC-SA 4.0
Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal xml:lang="en">CIDOC-CRM : RDFs Implementation (February 2024) of CIDOC-CRM 7.1.3</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal xml:lang="en">CRMdig Ontology 3.2.1 (April, 2016) including references to CIDOC-CRM 6.2</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal xml:lang="en">LRMoo Ontology 1.1.1 (November, 2025) including references to CIDOC-CRM 7.1.3</Literal>
    </Annotation>
