        <Literal xml:lang="pt">Atividade</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>crm:E7_Activity</AbbreviatedIRI>
        <Literal xml:lang="de">Handlung</Literal>
