        <Literal xml:lang="ru">Названиe</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>crm:E35_Title</AbbreviatedIRI>
        <Literal xml:lang="zh">题名</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>crm:E3_Condition_State</AbbreviatedIRI>
        <Literal xml:lang="en">This class comprises the states of objects characterised by a certain condition over a time-span.
An instance of this class describes the prevailing physical condition of any material object or feature during a specific instance of E52 Time-Span. In general, the time-span for which a certain condition can be asserted may be shorter than the real time-span, for which this condition held.
The nature of that condition can be described using P2 has type. For example, the instance of E3 Condition State “condition of the SS Great Britain between 22-nd September 1846 and 27-th August 1847” can be characterized as an instance “wrecked” of E55 Type.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>crm:E3_Condition_State</AbbreviatedIRI>
        <Literal xml:lang="en">Condition State</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>crm:E3_Condition_State</AbbreviatedIRI>
        <Literal xml:lang="pt">Estado Material</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>crm:E3_Condition_State</AbbreviatedIRI>
        <Literal xml:lang="de">Zustandsphase</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>crm:E3_Condition_State</AbbreviatedIRI>
        <Literal xml:lang="fr">État matériel</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
