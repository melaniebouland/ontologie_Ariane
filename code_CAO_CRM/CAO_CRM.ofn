Annotation(dc:creator "Model created by the Consortium HN Ariane and encoded by Mélanie Bouland"@en)
Annotation(dc:description "This ontological model was created by the Consortium HN Ariane. The aim is to formalize and improve the description of metada around corpora. Named CAO CRM, this model uses the CIDOC CRM and his extensions, LRMoo and CRMdig."@en)
Annotation(dc:rights "CC BY-NC-SA 4.0
Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International"@en)
Annotation(owl:versionInfo "CIDOC-CRM : RDFs Implementation (February 2024) of CIDOC-CRM 7.1.3"@en)
Annotation(owl:versionInfo "CRMdig Ontology 3.2.1 (April, 2016) including references to CIDOC-CRM 6.2"@en)
Annotation(owl:versionInfo "LRMoo Ontology 1.1.1 (November, 2025) including references to CIDOC-CRM 7.1.3"@en)

