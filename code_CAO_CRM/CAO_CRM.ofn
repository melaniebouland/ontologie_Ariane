# Annotation Property: dc:date (dc:date)

AnnotationPropertyRange(dc:date crm:E52_Time-Span)

# Annotation Property: dc:description (dc:description)

AnnotationPropertyRange(dc:description crm:E62_String)

# Annotation Property: dc:identifier (dc:identifier)

AnnotationPropertyRange(dc:identifier crm:E42_Identifier)

# Annotation Property: dc:language (dc:language)

AnnotationPropertyRange(dc:language crm:E56_Language)


############################
#   Object Properties
############################

# Object Property: lrm:R16_created (created)

AnnotationAssertion(rdfs:comment lrm:R16_created "This property associates the initial creation of a work and the instance of F1 Work that was created."@en)
AnnotationAssertion(rdfs:label lrm:R16_created "created"@en)
SubObjectPropertyOf(lrm:R16_created crm:P94_has_created)
InverseObjectProperties(lrm:R16_created lrm:R16i_was_created_by)
ObjectPropertyDomain(lrm:R16_created lrm:F27_Work_Creation)
ObjectPropertyRange(lrm:R16_created lrm:F1_Work)

# Object Property: lrm:R16i_was_created_by (lrm:R16i_was_created_by)

SubObjectPropertyOf(lrm:R16i_was_created_by crm:P94i_was_created_by)

# Object Property: lrm:R17_created (created)

AnnotationAssertion(rdfs:comment lrm:R17_created "This property associates an instance of F2 Expression that was externalised during a particular instance of F28 Expression Creation event with that particular creation event. An instance of expression creation creates an instance of expression and also creates any expressions that are parts of that expression."@en)
AnnotationAssertion(rdfs:label lrm:R17_created "created"@en)
SubObjectPropertyOf(lrm:R17_created crm:P94_has_created)
InverseObjectProperties(lrm:R17_created lrm:R17i_was_created_by)
ObjectPropertyDomain(lrm:R17_created lrm:F28_Expression_Creation)
ObjectPropertyRange(lrm:R17_created lrm:F2_Expression)

# Object Property: lrm:R17i_was_created_by (lrm:R17i_was_created_by)

SubObjectPropertyOf(lrm:R17i_was_created_by crm:P94i_was_created_by)

# Object Property: lrm:R24_created (created)

AnnotationAssertion(rdfs:comment lrm:R24_created "This property associates the instance of F3 Manifestation that was created during a particular instance of F30 Manifestation Creation with that instance of F30 Manifestation Creation event."@en)
AnnotationAssertion(rdfs:label lrm:R24_created "created"@en)
SubObjectPropertyOf(lrm:R24_created crm:P94_has_created)
InverseObjectProperties(lrm:R24_created lrm:R24i_was_created_through)
ObjectPropertyDomain(lrm:R24_created lrm:F30_Manifestation_Creation)
ObjectPropertyRange(lrm:R24_created lrm:F3_Manifestation)

# Object Property: lrm:R24i_was_created_through (lrm:R24i_was_created_through)

SubObjectPropertyOf(lrm:R24i_was_created_through crm:P94i_was_created_by)

# Object Property: lrm:R3_is_realised_in (lrm:R3_is_realised_in)

SubObjectPropertyOf(lrm:R3_is_realised_in crm:P130_shows_features_of)
InverseObjectProperties(lrm:R3_is_realised_in lrm:R3i_realises)
ObjectPropertyDomain(lrm:R3_is_realised_in lrm:F1_Work)
ObjectPropertyRange(lrm:R3_is_realised_in lrm:F2_Expression)

# Object Property: lrm:R3i_realises (lrm:R3i_realises)

SubObjectPropertyOf(lrm:R3i_realises crm:P130i_features_are_also_found_on)

# Object Property: lrm:R4_embodies (embodies)

AnnotationAssertion(rdfs:comment lrm:R4_embodies "This property associates an instance of F3 Manifestation with one or more instances of F2 Expression which are rendered by this instance of F3 Manifestation. The manifestation formats the expression(s) in the way they are to be presented to some public, including specifying the intended sensory impression (such as visual appearance or audio rendition)."@en)
AnnotationAssertion(rdfs:label lrm:R4_embodies "embodies"@en)
SubObjectPropertyOf(lrm:R4_embodies crm:P165_incorporates)
InverseObjectProperties(lrm:R4_embodies lrm:R4i_is_embodied_in)
ObjectPropertyDomain(lrm:R4_embodies lrm:F3_Manifestation)
ObjectPropertyRange(lrm:R4_embodies lrm:F2_Expression)

# Object Property: lrm:R4i_is_embodied_in (lrm:R4i_is_embodied_in)

SubObjectPropertyOf(lrm:R4i_is_embodied_in crm:P165i_is_incorporated_in)

# Object Property: lrm:R71_has_part (has part)

AnnotationAssertion(rdfs:comment lrm:R71_has_part "This property associates an instance of F3 Manifestation with a structural part of it that is itself an instance of F3 Manifestation. This property is transitive, asymmetric and irreflexive."@en)
AnnotationAssertion(rdfs:label lrm:R71_has_part "has part"@en)
SubObjectPropertyOf(lrm:R71_has_part crm:P148_has_component)
InverseObjectProperties(lrm:R71_has_part lrm:R71i_is_part_of)
ObjectPropertyDomain(lrm:R71_has_part lrm:F3_Manifestation)
ObjectPropertyRange(lrm:R71_has_part lrm:F3_Manifestation)

# Object Property: lrm:R71i_is_part_of (lrm:R71i_is_part_of)

SubObjectPropertyOf(lrm:R71i_is_part_of crm:P148i_is_component_of)

# Object Property: lrm:R78_has_alternate (has alternate)

AnnotationAssertion(rdfs:comment lrm:R78_has_alternate "This property associates one instance of F3 Manifestation with another instance of F3 Manifestation that exemplifies the same instance of F2 Expression, when the two instances of F3 Manifestation can be used as alternatives for each other in particular use cases. This property is transitive and symmetric. It is irreflexive. The alternative manifestations may be in the same physical form, for example, simultaneous publications in different markets. More frequently, the alternative relationship is established when the alternative manifestations are in different physical forms, designed to enable use of the same content with different playback equipment (such as a DVD and Blu-ray disc version of the same videorecording). This property is a shortcut for the path from one instance of F3 Manifestation to another instance of F3 Manifestation that are linked through R4 embodies (is embodied by) and its inverse, to the same instance of F2 Expression."@en)
AnnotationAssertion(rdfs:label lrm:R78_has_alternate "has alternate"@en)
ObjectPropertyDomain(lrm:R78_has_alternate lrm:F3_Manifestation)
ObjectPropertyRange(lrm:R78_has_alternate lrm:F3_Manifestation)

# Object Property: lrm:R7_exemplifies (exemplifies)

AnnotationAssertion(rdfs:comment lrm:R7_exemplifies "This property associates an instance of F3 Manifestation with an instance of F5 Item that is one of its exemplars or its only exemplar. Instances of F5 Item correspond to the kinds of physical unit(s) specified in the manifestation, regardless of possible later changes. Even though an item may exhibit defects with respect to the intended manifestation, it is still regarded to carry the manifestation, as long as it is produced or made accessible as a functional item by its creators."@en)
AnnotationAssertion(rdfs:label lrm:R7_exemplifies "exemplifies"@en)
SubObjectPropertyOf(lrm:R7_exemplifies crm:P128_carries)
InverseObjectProperties(lrm:R7_exemplifies lrm:R7i_is_exemplified_by)
ObjectPropertyDomain(lrm:R7_exemplifies lrm:F5_Item)
ObjectPropertyRange(lrm:R7_exemplifies lrm:F3_Manifestation)

# Object Property: lrm:R7i_is_exemplified_by (lrm:R7i_is_exemplified_by)

SubObjectPropertyOf(lrm:R7i_is_exemplified_by crm:P128i_is_carried_by)

# Object Property: crm:P100_was_death_of (was death of)

AnnotationAssertion(rdfs:comment crm:P100_was_death_of "This property links an instance of E69 Death to the instance of E21 Person that died.
An instance of E69 Death may involve multiple people, for example in the case of a battle or disaster.
This is not intended for use with general natural history material, only people."@en)
AnnotationAssertion(rdfs:label crm:P100_was_death_of "Tod von"@de)
AnnotationAssertion(rdfs:label crm:P100_was_death_of "a été la mort de"@fr)
AnnotationAssertion(rdfs:label crm:P100_was_death_of "foi a morte para"@pt)
AnnotationAssertion(rdfs:label crm:P100_was_death_of "was death of"@en)
AnnotationAssertion(rdfs:label crm:P100_was_death_of "ήταν θάνατος του/της"@el)
AnnotationAssertion(rdfs:label crm:P100_was_death_of "привёл к смeрти"@ru)
AnnotationAssertion(rdfs:label crm:P100_was_death_of "死亡的是"@zh)
SubObjectPropertyOf(crm:P100_was_death_of crm:P93_took_out_of_existence)
InverseObjectProperties(crm:P100_was_death_of crm:P100i_died_in)
ObjectPropertyDomain(crm:P100_was_death_of crm:E69_Death)
ObjectPropertyRange(crm:P100_was_death_of crm:E21_Person)

# Object Property: crm:P100i_died_in (crm:P100i_died_in)

SubObjectPropertyOf(crm:P100i_died_in crm:P93i_was_taken_out_of_existence_by)

# Object Property: crm:P104_is_subject_to (服从)

AnnotationAssertion(rdfs:comment crm:P104_is_subject_to "This property links a particular instance of E72 Legal Object to the instances of E30 Right to which it is subject.
The Right is held by an instance of E39 Actor as described by P75 possesses (is possessed by)."@en)
AnnotationAssertion(rdfs:label crm:P104_is_subject_to "Gegenstand von"@de)
AnnotationAssertion(rdfs:label crm:P104_is_subject_to "est soumis à"@fr)
AnnotationAssertion(rdfs:label crm:P104_is_subject_to "está sujeito à"@pt)
AnnotationAssertion(rdfs:label crm:P104_is_subject_to "is subject to"@en)
AnnotationAssertion(rdfs:label crm:P104_is_subject_to "υπόκειται σε"@el)
AnnotationAssertion(rdfs:label crm:P104_is_subject_to "подчиняeтся"@ru)
AnnotationAssertion(rdfs:label crm:P104_is_subject_to "服从"@zh)
InverseObjectProperties(crm:P104_is_subject_to crm:P104i_applies_to)
ObjectPropertyDomain(crm:P104_is_subject_to crm:E72_Legal_Object)
ObjectPropertyRange(crm:P104_is_subject_to crm:E30_Right)

# Object Property: crm:P108_has_produced (произвeл)

AnnotationAssertion(rdfs:comment crm:P108_has_produced "This property identifies the instance of E24 Physical Human-Made Thing that came into existence as a result of the instance of E12 Production.
The identity of an instance of E24 Physical Human-Made Thing is not defined by its matter, but by its existence as a subject of documentation. An E12 Production can result in the creation of multiple instances of E24 Physical Human-Made Thing."@en)
AnnotationAssertion(rdfs:label crm:P108_has_produced "a produit"@fr)
AnnotationAssertion(rdfs:label crm:P108_has_produced "has produced"@en)
AnnotationAssertion(rdfs:label crm:P108_has_produced "hat hergestellt"@de)
AnnotationAssertion(rdfs:label crm:P108_has_produced "produziu"@pt)
AnnotationAssertion(rdfs:label crm:P108_has_produced "παρήγαγε"@el)
AnnotationAssertion(rdfs:label crm:P108_has_produced "произвeл"@ru)
AnnotationAssertion(rdfs:label crm:P108_has_produced "已产生了"@zh)
SubObjectPropertyOf(crm:P108_has_produced crm:P31_has_modified)
SubObjectPropertyOf(crm:P108_has_produced crm:P92_brought_into_existence)
InverseObjectProperties(crm:P108_has_produced crm:P108i_was_produced_by)
ObjectPropertyDomain(crm:P108_has_produced crm:E12_Production)
ObjectPropertyRange(crm:P108_has_produced crm:E24_Physical_Human-Made_Thing)

# Object Property: crm:P108i_was_produced_by (crm:P108i_was_produced_by)

SubObjectPropertyOf(crm:P108i_was_produced_by crm:P92i_was_brought_into_existence_by)

# Object Property: crm:P11_had_participant (crm:P11_had_participant)

InverseObjectProperties(crm:P11_had_participant crm:P11i_participated_in)
ObjectPropertyDomain(crm:P11_had_participant crm:E5_Event)
ObjectPropertyRange(crm:P11_had_participant crm:E39_Actor)

# Object Property: crm:P127_has_broader_term (has broader term)

AnnotationAssertion(rdfs:comment crm:P127_has_broader_term "This property associates an instance of E55 Type with another instance of E55 Type that has a broader meaning.
It allows instances of E55 Types to be organised into hierarchies. This is the sense of “broader term generic (BTG)” as defined in ISO 25964-2:2013 (International Organization for Standardization 2013).
This property is transitive. This property is asymmetric."@en)
AnnotationAssertion(rdfs:label crm:P127_has_broader_term "a pour terme général"@fr)
AnnotationAssertion(rdfs:label crm:P127_has_broader_term "has broader term"@en)
AnnotationAssertion(rdfs:label crm:P127_has_broader_term "hat den Oberbegriff"@de)
AnnotationAssertion(rdfs:label crm:P127_has_broader_term "tem termo genérico"@pt)
AnnotationAssertion(rdfs:label crm:P127_has_broader_term "έχει ευρύτερο όρο"@el)
AnnotationAssertion(rdfs:label crm:P127_has_broader_term "имeeт вышeстоящий тeрмин"@ru)
AnnotationAssertion(rdfs:label crm:P127_has_broader_term "上位词"@zh)
InverseObjectProperties(crm:P127_has_broader_term crm:P127i_has_narrower_term)
TransitiveObjectProperty(crm:P127_has_broader_term)
ObjectPropertyDomain(crm:P127_has_broader_term crm:E55_Type)
ObjectPropertyRange(crm:P127_has_broader_term crm:E55_Type)

# Object Property: crm:P128_carries (φέρει)

AnnotationAssertion(rdfs:comment crm:P128_carries "This property identifies an instance E90 Symbolic Object carried by an instance of E18 Physical Thing. Since an instance of E90 Symbolic Object is defined as an immaterial idealization over potentially multiple carriers, any individual realization on a particular physical carrier may be defective, due to deterioration or shortcomings in the process of creating the realization compared to the intended ideal. As long as such defects do not substantially affect the complete recognition of the respective symbolic object, it is still regarded as carrying an instance of this E90 Symbolic Object. If these defects are of scholarly interest, the particular realization can be modelled as an instance of E25 Human-Made Feature. Note, that any instance of E90 Symbolic Object incorporated (P165) in the carried symbolic object is also carried by the same instance of E18 Physical Thing."@en)
AnnotationAssertion(rdfs:label crm:P128_carries "carries"@en)
AnnotationAssertion(rdfs:label crm:P128_carries "est le support de"@fr)
