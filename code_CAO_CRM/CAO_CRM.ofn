ObjectPropertyDomain(crm:P191_had_duration crm:E52_Time-Span)
ObjectPropertyRange(crm:P191_had_duration crm:E54_Dimension)

# Object Property: crm:P19_was_intended_use_of (ήταν προορισμένη χρήση του)

AnnotationAssertion(rdfs:comment crm:P19_was_intended_use_of "This property relates an instance of E7 Activity with instances of E71 Human-Made Thing, created specifically for use in the activity.
This is distinct from the intended use of an item in some general type of activity such as the book of common prayer which was intended for use in Church of England services (see P101 had as general use (was use of))."@en)
AnnotationAssertion(rdfs:label crm:P19_was_intended_use_of "a été l’usage prévu de"@fr)
AnnotationAssertion(rdfs:label crm:P19_was_intended_use_of "era prevista a utilização de"@pt)
AnnotationAssertion(rdfs:label crm:P19_was_intended_use_of "war beabsichtigteter Gebrauch von"@de)
AnnotationAssertion(rdfs:label crm:P19_was_intended_use_of "was intended use of"@en)
AnnotationAssertion(rdfs:label crm:P19_was_intended_use_of "ήταν προορισμένη χρήση του"@el)
AnnotationAssertion(rdfs:label crm:P19_was_intended_use_of "прeдполагал использованиe"@ru)
AnnotationAssertion(rdfs:label crm:P19_was_intended_use_of "特定用途是"@zh)
