AnnotationAssertion(rdfs:label crm:P128_carries "é o suporte de"@pt)
AnnotationAssertion(rdfs:label crm:P128_carries "φέρει"@el)
AnnotationAssertion(rdfs:label crm:P128_carries "нeсeт"@ru)
AnnotationAssertion(rdfs:label crm:P128_carries "承载"@zh)
