AnnotationAssertion(rdfs:isDefinedBy dcterms:title <http://purl.org/dc/terms/>)
AnnotationAssertion(rdfs:label dcterms:title "Title"@en)
EquivalentDataProperties(dcterms:title <http://www.CAO_CRM.org/ontology/Title>)
DataPropertyRange(dcterms:title rdfs:Literal)

