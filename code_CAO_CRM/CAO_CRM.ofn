AnnotationAssertion(rdfs:label crm:P21_had_general_purpose "tinha propósito geral"@pt)
AnnotationAssertion(rdfs:label crm:P21_had_general_purpose "είχε γενικό σκοπό"@el)
AnnotationAssertion(rdfs:label crm:P21_had_general_purpose "имeл общую цeль"@ru)
AnnotationAssertion(rdfs:label crm:P21_had_general_purpose "有一般目的"@zh)
