AnnotationAssertion(rdfs:label crm:P67_refers_to "αναφέρεται σε"@el)
AnnotationAssertion(rdfs:label crm:P67_refers_to "ссылаeтся на"@ru)
AnnotationAssertion(rdfs:label crm:P67_refers_to "涉及"@zh)
