    "@value" : "a donné vie à"
  }, {
    "@language" : "de",
    "@value" : "brachte zur Welt"
  }, {
    "@language" : "en",
    "@value" : "brought into life"
  }, {
    "@language" : "pt",
    "@value" : "trouxe à vida"
  }, {
    "@language" : "el",
    "@value" : "έφερε στη ζωή"
  }, {
    "@language" : "ru",
    "@value" : "родил"
  }, {
    "@language" : "zh",
    "@value" : "诞生了"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E21_Person"
  } ],
