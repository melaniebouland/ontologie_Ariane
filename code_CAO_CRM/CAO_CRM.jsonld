}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P44_has_condition",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property records an E3 Condition State for some E18 Physical Thing.\nThis property is a shortcut of the more fully developed path from E18 Physical Thing through P34i was assessed by, E14 Condition Assessment, P35 has identified to E3 Condition State. It offers no information about how and when the E3 Condition State was established, nor by whom.\nAn instance of E3 Condition State is specific to an instance of E18 Physical Thing."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"
  } ],
