}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P94i_was_created_by",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P98_brought_into_life",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property links an instance of E67 Birth event to an instance of E21 Person in the role of offspring.\nTwins, triplets etc. are brought into life by the same instance of E67 Birth. This is not intended for use with general Natural History material, only people. There is no explicit method for modelling conception and gestation except by using extensions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E67_Birth"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
