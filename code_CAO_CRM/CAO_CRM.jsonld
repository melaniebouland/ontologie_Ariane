    "@value" : "consiste de"
  }, {
    "@language" : "en",
    "@value" : "consists of"
  }, {
    "@language" : "el",
    "@value" : "αποτελείται από"
  }, {
    "@language" : "ru",
    "@value" : "состоит из"
  }, {
    "@language" : "zh",
    "@value" : "包含"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E57_Material"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
