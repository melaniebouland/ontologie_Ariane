  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E42_Identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"
  } ],
