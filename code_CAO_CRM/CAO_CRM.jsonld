}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P43_has_dimension",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property records an instance of E54 Dimension of some instance of E70 Thing.\nIn the case that the recorded property is a result of a measurement of an instance of E18 Physical Thing, this property is a shortcut of the more fully developed path from E18 Physical Thing through P39i was measured by, E16 Measurement, P40 observed dimension to E54 Dimension.\nIt offers no information about how and when an E54 Dimension was established, nor by whom. Knowledge about an instance of E54 Dimension need not be the result of a measurement; it may be the result of evaluating data or other information, which should be documented as an instance of E13 Attribute Assignment.\nAn instance of E54 Dimension is specific to an instance of E70 Thing."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E70_Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
