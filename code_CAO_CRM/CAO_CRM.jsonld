    "@language" : "de",
    "@value" : "hat Zustand"
  }, {
    "@language" : "pt",
    "@value" : "tem estado material"
  }, {
    "@language" : "el",
    "@value" : "έχει κατάσταση"
  }, {
    "@language" : "ru",
    "@value" : "имeeт условиe"
  }, {
