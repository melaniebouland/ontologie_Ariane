}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P165_incorporates",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E73_Information_Object"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P165i_is_incorporated_in"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P165i_is_incorporated_in",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property describes the use of material or immaterial things in a way essential to the performance or the outcome of an instance of E7 Activity.\nThis property typically applies to tools, instruments, moulds, raw materials and items embedded in a product. It implies that the presence of the object in question was a necessary condition for the action. For example, the activity of writing this text required the use of a computer. An immaterial thing can be used if at least one of its carriers is present. For example, the software tools on a computer.\nAnother example is the use of a particular name by a particular group of people over some span to identify a thing, such as a settlement. In this case, the physical carriers of this name are at least the people understanding its use."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E7_Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "a mobilisé l’objet spécifique"
  }, {
    "@language" : "de",
    "@value" : "benutzte das bestimmte Objekt"
  }, {
    "@language" : "en",
    "@value" : "used specific object"
  }, {
    "@language" : "pt",
    "@value" : "usou objeto específico"
  }, {
    "@language" : "el",
    "@value" : "χρησιμοποίησε αντικείμενο"
  }, {
    "@language" : "ru",
    "@value" : "пользовался"
  }, {
    "@language" : "zh",
    "@value" : "使用特定对象"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E70_Thing"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P12_occurred_in_the_presence_of"
  }, {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P15_was_influenced_by"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P16i_was_used_for"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P16i_was_used_for",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P12i_was_present_at"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P191_had_duration",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property describes the length of time covered by an instance of E52 Time-Span. It allows an instance of E52 Time-Span to be associated with an instance of E54 Dimension representing duration independent from the actual beginning and end. Indeterminacy of the duration value can be expressed by assigning a numerical interval to the property P90 has value of E54 Dimension."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "a eu pour durée"
  }, {
    "@language" : "en",
    "@value" : "had duration"
  }, {
    "@language" : "ru",
    "@value" : "имeл продолжитeльность"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E54_Dimension"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P191i_was_duration_of"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P191i_was_duration_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P19_was_intended_use_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property relates an instance of E7 Activity with instances of E71 Human-Made Thing, created specifically for use in the activity.\nThis is distinct from the intended use of an item in some general type of activity such as the book of common prayer which was intended for use in Church of England services (see P101 had as general use (was use of))."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E7_Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "a été l’usage prévu de"
  }, {
    "@language" : "pt",
    "@value" : "era prevista a utilização de"
  }, {
    "@language" : "de",
    "@value" : "war beabsichtigteter Gebrauch von"
  }, {
    "@language" : "en",
    "@value" : "was intended use of"
  }, {
    "@language" : "el",
    "@value" : "ήταν προορισμένη χρήση του"
  }, {
    "@language" : "ru",
    "@value" : "прeдполагал использованиe"
  }, {
    "@language" : "zh",
    "@value" : "特定用途是"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E71_Human-Made_Thing"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P19i_was_made_for"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P19i_was_made_for",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property describes the naming or identification of any real-world item by a name or any other identifier.\nThis property is intended for identifiers in general use, which form part of the world the model intends to describe, and not merely for internal database identifiers which are specific to a technical system, unless these latter also have a more general use outside the technical context. This property includes in particular identification by mathematical expressions such as coordinate systems used for the identification of instances of E53 Place. The property does not reveal anything about when, where and by whom this identifier was used. A more detailed representation can be made using the fully developed (i.e. indirect) path through E15 Identifier Assignment.\nThis property is a shortcut for the path from E1 CRM Entity through P140i was attributed by, E15 Identifier Assignment, P37 assigned to E42 Identifier.\nIt is also a shortcut for the path from E1 CRM Entity through P1 is identified by, E41 Appellation, P139 has alternative form to E41 Appellation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "est identifié par"
  }, {
    "@language" : "en",
    "@value" : "is identified by"
  }, {
    "@language" : "de",
    "@value" : "wird bezeichnet als"
  }, {
    "@language" : "pt",
    "@value" : "é identificado por"
  }, {
    "@language" : "el",
    "@value" : "αναγνωρίζεται ως"
  }, {
    "@language" : "ru",
    "@value" : "идeнтифицируeтся"
  }, {
    "@language" : "zh",
    "@value" : "被标识为"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E41_Appellation"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P1i_identifies"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P1i_identifies",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P20_had_specific_purpose",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property describes the relationship between a preparatory activity, an instance of E7 Activity and the instance of E5 Event that it is intended as a preparation for.\nThis includes activities, orders and other organisational actions, taken in preparation for other activities or events.\nP20 had specific purpose (was purpose of) implies that the activity succeeded in achieving its aim. If it does not succeed, such as the setting of a trap that did not catch anything, the unrealized intention should be documented using P21 had general purpose (was purpose of): E55 Type and/or P33 used specific technique (was used by): E29 Design or Procedure."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E7_Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "a eu pour finalité spécifique"
  }, {
    "@language" : "en",
    "@value" : "had specific purpose"
  }, {
    "@language" : "de",
    "@value" : "hatte den bestimmten Zweck"
  }, {
    "@language" : "pt",
    "@value" : "tinha propósito específico"
  }, {
    "@language" : "el",
    "@value" : "είχε συγκεκριμένο σκοπό"
  }, {
    "@language" : "ru",
    "@value" : "имeл конкрeтную цeль"
  }, {
    "@language" : "zh",
    "@value" : "有特定目的"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E5_Event"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P20i_was_purpose_of"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P20i_was_purpose_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P21_had_general_purpose",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property describes an intentional relationship between an instance of E7 Activity and some general goal or purpose, described as an instance of E55 Type.\nThis may involve activities intended as preparation for some type of activity or event. P21 had general purpose (was purpose of) differs from P20 had specific purpose (was purpose of in that no specific event is implied as the purpose."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E7_Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "a eu pour finalité générale"
  }, {
    "@language" : "en",
    "@value" : "had general purpose"
  }, {
    "@language" : "de",
    "@value" : "hatte den allgemeinen Zweck"
  }, {
    "@language" : "pt",
    "@value" : "tinha propósito geral"
  }, {
    "@language" : "el",
    "@value" : "είχε γενικό σκοπό"
  }, {
    "@language" : "ru",
    "@value" : "имeл общую цeль"
  }, {
    "@language" : "zh",
    "@value" : "有一般目的"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E55_Type"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P21i_was_purpose_of"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P21i_was_purpose_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P2_has_type",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property allows sub-typing of CIDOC CRM entities –a form of specialisation – through the use of a terminological hierarchy, or thesaurus.\nThe CIDOC CRM is intended to focus on the high-level entities and relationships needed to describe data structures. Consequently, it does not specialise entities any further than is required for this immediate purpose. However, entities in the isA hierarchy of the CIDOC CRM may by specialised into any number of sub-entities, which can be defined in the E55 Type hierarchy. E41 Appellation, for example, may be specialised into “e-mail address”, “telephone number”, “post office box”, “URL”, etc., none of which figures explicitly in the CIDOC CRM class hierarchy. A comprehensive explanation about refining CIDOC CRM concepts by E55 Type is given in the section “About Types” in the section on “Specific Modelling Constructs” of this document.\nThis property is a shortcut for the path from E1 CRM Entity through P41i was classified by, E17 Type Assignment, P42 assigned to E55 Type."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "fr",
    "@value" : "a pour type"
  }, {
    "@language" : "en",
    "@value" : "has type"
  }, {
    "@language" : "de",
    "@value" : "hat den Typus"
  }, {
    "@language" : "pt",
    "@value" : "é do tipo"
  }, {
    "@language" : "el",
    "@value" : "έχει τύπο"
  }, {
    "@language" : "ru",
    "@value" : "имeeт тип"
  }, {
    "@language" : "zh",
    "@value" : "有类型"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E55_Type"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P2i_is_type_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P31_has_modified",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E11_Modification"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P31i_was_modified_by"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P31i_was_modified_by",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P39_measured",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E16_Measurement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E18_Physical_Thing"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P39i_was_measured_by"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P39i_was_measured_by",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P3_has_note",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property is a container for all informal descriptions about an object that have not been expressed in terms of CIDOC CRM constructs.\nIn particular, it captures the characterisation of the item itself, its internal structures, appearance, etc.\nLike property P2 has type (is type of), this property is a consequence of the restricted focus of the CIDOC CRM. The aim is not to capture, in a structured form, everything that can be said about an item; indeed, the CIDOC CRM formalism is not regarded as sufficient to express everything that can be said. Good practice requires use of distinct note fields for different aspects of a characterisation. The P3.1 has type property of P3 has note allows differentiation of specific notes, e.g. “construction”, “decoration”, etc."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
