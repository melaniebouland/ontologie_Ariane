  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P11i_participated_in"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P150_defines_typical_parts_of",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This property associates an instance of E55 Type “A” with an instance of E55 Type “B”, when items of type “A” typically form part of items of type “B”, such as “car motors” and “cars”.\nIt allows types to be organised into hierarchies based on one type describing a typical part of another. This property is equivalent to “broader term partitive (BTP)” as defined in ISO 2788 and “broaderPartitive” in SKOS.\nThis property is not transitive. This property is asymmetric."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E55_Type"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "defines typical parts of"
  }, {
    "@language" : "fr",
    "@value" : "définit les éléments typiques de"
  }, {
    "@language" : "ru",
    "@value" : "опрeдeляeт типичныe части"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E55_Type"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/P150i_defines_typical_wholes_for"
  } ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P150i_defines_typical_wholes_for",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ]
}, {
  "@id" : "http://www.cidoc-crm.org/cidoc-crm/P15_was_influenced_by",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.cidoc-crm.org/cidoc-crm/E7_Activity"
  } ],
